{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"]
    },
    {
      "name": "Run Extension in Folder…",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${input:folder}",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"]
    },
    {
      "name": "Run Extension in Workspace…",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${input:workspaceFile}",
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"
      ],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.cjs"]
    }
  ],
  "inputs": [
    {
      "id": "folder",
      "type": "promptString",
      "description": "Folder to open in the Extension Development Host",
      "default": "${workspaceFolder}/playground"
    },
    {
      "id": "workspaceFile",
      "type": "promptString",
      "description": "Path of the .code-workspace file to open in the Extension Development Host"
    }
  ]
}
