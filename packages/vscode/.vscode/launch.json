{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension on playground",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/../../playground"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "build"
    }
  ]
}
