{
  "name": "localness-vscode",
  "displayName": "Localness",
  "description": "Hover, inline hints, diagnostics and a key browser for Localness translation keys.",
  "version": "0.1.0",
  "private": true,
  "publisher": "localness",
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwacc/localness-tools.git",
    "directory": "packages/vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localness.signIn",
        "title": "Sign in",
        "category": "Localness"
      },
      {
        "command": "localness.openReview",
        "title": "Open waiting review",
        "category": "Localness"
      },
      {
        "command": "localness.signOut",
        "title": "Sign out",
        "category": "Localness"
      },
      {
        "command": "localness.selectProject",
        "title": "Select project",
        "category": "Localness"
      },
      {
        "command": "localness.switchDisplayLocale",
        "title": "Switch display locale",
        "category": "Localness",
        "icon": "$(globe)"
      },
      {
        "command": "localness.switchInlineHintMode",
        "title": "Switch inline hint mode",
        "category": "Localness",
        "icon": "$(eye)"
      },
      {
        "command": "localness.refresh",
        "title": "Refresh",
        "category": "Localness",
        "icon": "$(refresh)"
      },
      {
        "command": "localness.searchKeys",
        "title": "Search keys",
        "category": "Localness",
        "icon": "$(search)"
      },
      {
        "command": "localness.openKey",
        "title": "Open key in Localness",
        "category": "Localness"
      },
      {
        "command": "localness.showMenu",
        "title": "Show menu",
        "category": "Localness"
      },
      {
        "command": "localness.editTranslation",
        "title": "Edit translation",
        "category": "Localness",
        "icon": "$(edit)"
      },
      {
        "command": "localness.copyKey",
        "title": "Copy key",
        "category": "Localness"
      },
      {
        "command": "localness.extractText",
        "title": "Extract to Localness",
        "category": "Localness"
      },
      {
        "command": "localness.sync.refresh",
        "title": "Compare locale files",
        "category": "Localness",
        "icon": "$(refresh)"
      },
      {
        "command": "localness.sync.pull",
        "title": "Pull project changes into locale files",
        "category": "Localness",
        "icon": "$(cloud-download)"
      },
      {
        "command": "localness.sync.compare",
        "title": "Compare with the project",
        "category": "Localness",
        "icon": "$(diff)"
      },
      {
        "command": "localness.sync.openFile",
        "title": "Open locale file",
        "category": "Localness",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localness.sync.openInProject",
        "title": "Open key in Localness",
        "category": "Localness",
        "icon": "$(link-external)"
      },
      {
        "command": "localness.sync.runCli",
        "title": "Run Localness CLI in terminal",
        "category": "Localness",
        "icon": "$(terminal)"
      },
      {
        "command": "localness.findUsages",
        "title": "Find usages",
        "category": "Localness",
        "icon": "$(references)"
      },
      {
        "command": "localness.sync.push",
        "title": "Push local changes to the project",
        "category": "Localness",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "localness.sync.pushKey",
        "title": "Push to Localness",
        "category": "Localness",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "localness.openLocalFile",
        "title": "Open local file",
        "category": "Localness",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localness.selectRelease",
        "title": "Select release for new keys",
        "category": "Localness",
        "icon": "$(tag)"
      },
      {
        "command": "localness.editReleases",
        "title": "Edit releases…",
        "category": "Localness",
        "icon": "$(tag)"
      },
      {
        "command": "localness.filterKeysByRelease",
        "title": "Filter keys by release",
        "category": "Localness",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "localness.extractText",
          "when": "editorHasSelection"
        },
        {
          "command": "localness.copyKey",
          "when": "false"
        },
        {
          "command": "localness.openKey",
          "when": "false"
        },
        {
          "command": "localness.showMenu",
          "when": "false"
        },
        {
          "command": "localness.sync.compare",
          "when": "false"
        },
        {
          "command": "localness.sync.openFile",
          "when": "false"
        },
        {
          "command": "localness.sync.openInProject",
          "when": "false"
        },
        {
          "command": "localness.sync.refresh",
          "when": "localness.hasLocaleFiles"
        },
        {
          "command": "localness.sync.pull",
          "when": "localness.hasLocaleFiles"
        },
        {
          "command": "localness.sync.runCli",
          "when": "localness.hasLocaleFiles"
        },
        {
          "command": "localness.findUsages",
          "when": "false"
        },
        {
          "command": "localness.sync.push",
          "when": "localness.hasLocaleFiles"
        },
        {
          "command": "localness.openLocalFile",
          "when": "false"
        },
        {
          "command": "localness.sync.pushKey",
          "when": "false"
        },
        {
          "command": "localness.editReleases",
          "when": "false"
        },
        {
          "command": "localness.selectRelease",
          "when": "localness.ready"
        },
        {
          "command": "localness.filterKeysByRelease",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "localness.searchKeys",
          "when": "view == localness.keys",
          "group": "navigation@1"
        },
        {
          "command": "localness.switchDisplayLocale",
          "when": "view == localness.keys",
          "group": "navigation@1"
        },
        {
          "command": "localness.filterKeysByRelease",
          "when": "view == localness.keys",
          "group": "navigation@2"
        },
        {
          "command": "localness.refresh",
          "when": "view == localness.keys",
          "group": "navigation@3"
        },
        {
          "command": "localness.sync.pull",
          "when": "view == localness.sync",
          "group": "navigation@1"
        },
        {
          "command": "localness.sync.refresh",
          "when": "view == localness.sync",
          "group": "navigation@3"
        },
        {
          "command": "localness.sync.runCli",
          "when": "view == localness.sync",
          "group": "navigation@4"
        },
        {
          "command": "localness.sync.push",
          "when": "view == localness.sync",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "localness.extractText",
          "when": "editorHasSelection",
          "group": "1_modification@9"
        }
      ],
      "view/item/context": [
        {
          "command": "localness.editTranslation",
          "when": "view == localness.keys && viewItem == key",
          "group": "inline@2"
        },
        {
          "command": "localness.sync.pull",
          "when": "view == localness.sync && viewItem =~ /^syncGroup.*\\.pull/",
          "group": "inline"
        },
        {
          "command": "localness.sync.openFile",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.local/",
          "group": "inline@1"
        },
        {
          "command": "localness.sync.pull",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.pull/",
          "group": "inline@3"
        },
        {
          "command": "localness.sync.compare",
          "when": "view == localness.sync && viewItem =~ /^syncEntry/",
          "group": "1_open@1"
        },
        {
          "command": "localness.sync.openFile",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.local/",
          "group": "1_open@2"
        },
        {
          "command": "localness.sync.openInProject",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.project/",
          "group": "1_open@3"
        },
        {
          "command": "localness.sync.pull",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.pull/",
          "group": "2_sync@1"
        },
        {
          "command": "localness.findUsages",
          "when": "view == localness.keys && viewItem =~ /^(key|localKey)$/",
          "group": "1_open@1"
        },
        {
          "command": "localness.openKey",
          "when": "view == localness.keys && viewItem == key",
          "group": "1_open@3"
        },
        {
          "command": "localness.editTranslation",
          "when": "view == localness.keys && viewItem == key",
          "group": "2_edit@1"
        },
        {
          "command": "localness.copyKey",
          "when": "view == localness.keys && viewItem =~ /^(key|localKey)$/",
          "group": "3_copy@1"
        },
        {
          "command": "localness.sync.push",
          "when": "view == localness.sync && viewItem =~ /^syncGroup.*\\.push/",
          "group": "inline"
        },
        {
          "command": "localness.sync.push",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.push/",
          "group": "inline@2"
        },
        {
          "command": "localness.sync.push",
          "when": "view == localness.sync && viewItem =~ /^syncEntry.*\\.push/",
          "group": "2_sync@2"
        },
        {
          "command": "localness.openLocalFile",
          "when": "view == localness.keys && viewItem =~ /^(key|localKey)$/ && localness.hasLocaleFiles",
          "group": "inline@1"
        },
        {
          "command": "localness.openLocalFile",
          "when": "view == localness.keys && viewItem =~ /^(key|localKey)$/ && localness.hasLocaleFiles",
          "group": "1_open@2"
        },
        {
          "command": "localness.sync.pushKey",
          "when": "view == localness.keys && viewItem == localKey",
          "group": "inline@2"
        },
        {
          "command": "localness.sync.pushKey",
          "when": "view == localness.keys && viewItem == localKey",
          "group": "2_edit@1"
        },
        {
          "command": "localness.editReleases",
          "when": "view == localness.keys && viewItem =~ /^(key|group)$/",
          "group": "2_edit@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localness",
          "title": "Localness",
          "icon": "media/localness.svg"
        }
      ]
    },
    "views": {
      "localness": [
        {
          "id": "localness.keys",
          "name": "Keys"
        },
        {
          "id": "localness.sync",
          "name": "Local Files",
          "when": "localness.ready"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "localness.keys",
        "contents": "Connect to a Localness instance to browse translation keys.\n[Sign in](command:localness.signIn)\n[Select project](command:localness.selectProject)",
        "when": "!localness.ready"
      },
      {
        "view": "localness.sync",
        "contents": "Add `files` to localness.config.json to compare the locale files with the project.\n[Open Localness CLI docs](https://github.com/Hwacc/localness-tools/tree/main/packages/cli#readme)",
        "when": "!localness.hasLocaleFiles"
      }
    ],
    "configuration": {
      "title": "Localness",
      "properties": {
        "localness.displayLocale": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "Locale shown in hovers, inline hints and the key tree. Empty picks the first non-source locale."
        },
        "localness.inlineHints": {
          "type": "string",
          "enum": [
            "inline",
            "replace",
            "off"
          ],
          "enumDescriptions": [
            "Show the display-locale text after each recognised key.",
            "Show the display-locale text in place of the key; see `#localness.replaceRevealOn#`.",
            "Do not show inline hints."
          ],
          "default": "inline",
          "scope": "window",
          "description": "How the display-locale text of recognised keys is shown in the editor."
        },
        "localness.inlineHintStyle": {
          "type": "string",
          "enum": [
            "inlay",
            "dot",
            "arrow",
            "plain"
          ],
          "enumDescriptions": [
            "Like native inlay hints: theme inlay-hint colours on a rounded background.",
            "Separated by a middle dot: t('key'·text).",
            "Separated by an arrow: t('key' → text).",
            "Italic text after a space."
          ],
          "default": "inlay",
          "scope": "window",
          "description": "Look of inline hints in `inline` mode."
        },
        "localness.replaceRevealOn": {
          "type": "string",
          "enum": [
            "line",
            "cursor"
          ],
          "enumDescriptions": [
            "Show the key while the cursor or a selection is on its line.",
            "Show the key only while the cursor or a selection touches the key or its quotes."
          ],
          "default": "line",
          "scope": "window",
          "description": "When a key replaced by its translation (`replace` mode) is shown again."
        },
        "localness.inlineHintMaxLength": {
          "type": "number",
          "default": 40,
          "minimum": 5,
          "scope": "window",
          "description": "Longest inline hint, in characters, before it is truncated."
        },
        "localness.keyUnderline": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Underline recognised keys that exist in the Localness project."
        },
        "localness.diagnostics": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Warn about recognised keys that do not exist in the project."
        },
        "localness.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "typescript",
            "typescriptreact",
            "javascript",
            "javascriptreact",
            "vue",
            "html"
          ],
          "scope": "window",
          "markdownDescription": "Language ids in which keys are recognised."
        },
        "localness.cliCommand": {
          "type": "string",
          "default": "localness",
          "scope": "window",
          "markdownDescription": "How the Local Files view runs the Localness CLI, for example `npx localness` or `pnpm exec localness`. It runs in the folder of `localness.config.json` and reads its own `LOCALNESS_TOKEN` from `.env.local`."
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@localness/sdk": "workspace:*",
    "@types/vscode": "~1.90.0",
    "flag-icons": "^7.6.0"
  }
}
