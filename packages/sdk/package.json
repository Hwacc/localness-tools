{
  "name": "@localness/sdk",
  "version": "0.2.0",
  "description": "Typed client, cache layer, change detection and locale-file sync for the Localness public /api/v1.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.mts",
        "default": "./dist/sync.mjs"
      },
      "require": {
        "types": "./dist/sync.d.cts",
        "default": "./dist/sync.cjs"
      }
    },
    "./review": {
      "import": {
        "types": "./dist/review.d.mts",
        "default": "./dist/review.mjs"
      },
      "require": {
        "types": "./dist/review.d.cts",
        "default": "./dist/review.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hwacc/localness-tools.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@localness/contract": "^0.5.1",
    "zod": "^4.6.7"
  }
}
